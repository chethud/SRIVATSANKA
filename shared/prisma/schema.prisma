generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enquiries (from WhatsApp) ─────────────────────────────────────────────

enum EnquiryStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}

model Enquiry {
  id                   String        @id @default(cuid())
  customerName         String
  phoneNumber          String
  eventType            String
  eventDate            DateTime
  eventLocation        String
  guestCount           Int
  preferredCallbackAt  DateTime
  status               EnquiryStatus @default(NEW)
  reminderSent         Boolean       @default(false)
  notes                String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  order                Order?
}

// ─── Orders ──────────────────────────────────────────────────────────────────

enum OrderStatus {
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Order {
  id              String      @id @default(cuid())
  orderId         String      @unique // e.g. ORD-0001
  enquiryId       String?     @unique
  enquiry         Enquiry?    @relation(fields: [enquiryId], references: [id])
  customerName    String
  phoneNumber     String
  eventType       String
  eventDate       DateTime
  eventLocation   String
  guestCount      Int
  totalAmount     Decimal     @db.Decimal(12, 2)
  advancePayment  Decimal     @db.Decimal(12, 2)
  balanceAmount   Decimal     @db.Decimal(12, 2)
  status          OrderStatus @default(CONFIRMED)
  items           OrderItem[]
  invoices        Invoice[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

// ─── Dishes ──────────────────────────────────────────────────────────────────

enum DishCategory {
  SOUTH_INDIAN
  NORTH_INDIAN
  CHINESE
  SNACKS
  DESSERTS
  BEVERAGES
}

enum DishCustomization {
  NO_MILK
  NO_ONION
  NO_GARLIC
  LESS_SPICE
  LESS_SWEET
  EXTRA_VEGETABLES
}

model Dish {
  id          String       @id @default(cuid())
  name        String
  category    DishCategory
  price       Decimal      @db.Decimal(10, 2)
  description String?
  isActive    Boolean      @default(true)
  orderItems  OrderItem[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model OrderItem {
  id              String              @id @default(cuid())
  orderId         String
  order           Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dishId          String
  dish            Dish                @relation(fields: [dishId], references: [id])
  quantity        Int                 @default(1)
  unitPrice       Decimal             @db.Decimal(10, 2)
  customizations  DishCustomization[]
  notes           String?
}

// ─── Vendors ─────────────────────────────────────────────────────────────────

enum VendorCategory {
  MARRIAGE_HALL
  EVENT_ORGANIZER
  DECORATOR
  PHOTOGRAPHER
  DJ
  VEGETABLE_SUPPLIER
  RICE_SUPPLIER
  TRANSPORT_PROVIDER
}

model Vendor {
  id           String         @id @default(cuid())
  name         String
  businessName String?
  phoneNumber  String
  category     VendorCategory
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

// ─── Invoices ────────────────────────────────────────────────────────────────

enum InvoiceType {
  KITCHEN_COPY
  BILLING_COPY
}

model Invoice {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      InvoiceType
  filePath  String?
  createdAt DateTime    @default(now())
}

// ─── Expenses ────────────────────────────────────────────────────────────────

enum ExpenseCategory {
  PURCHASE_BILL
  VEGETABLE_BILL
  TRANSPORT_BILL
  MISCELLANEOUS
}

model Expense {
  id          String          @id @default(cuid())
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(12, 2)
  description String?
  filePath    String?
  fileType    String?         // pdf, image, excel
  expenseDate DateTime        @default(now())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

// ─── Workers ─────────────────────────────────────────────────────────────────

model Worker {
  id              String           @id @default(cuid())
  name            String
  phoneNumber     String
  role            String
  dailyWage       Decimal          @db.Decimal(10, 2)
  paymentHistory  WorkerPayment[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model WorkerPayment {
  id          String   @id @default(cuid())
  workerId    String
  worker      Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  amount      Decimal  @db.Decimal(10, 2)
  paymentDate DateTime @default(now())
  notes       String?
}

// ─── Notifications ───────────────────────────────────────────────────────────

enum NotificationType {
  NEW_ENQUIRY
  CALLBACK_REMINDER
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())
}

// ─── Settings ────────────────────────────────────────────────────────────────

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}
