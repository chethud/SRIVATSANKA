# Local dev (SQLite):
# DATABASE_URL=sqlite+aiosqlite:///./kannans.db
#
# Supabase — database (use Session pooler on Render; Direct often fails with "Network is unreachable")
# DATABASE_URL=postgresql://postgres.hlzndlmcvpmsxzkawsbz:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Local dev can use Direct: postgresql://postgres:YOUR_PASSWORD@db.hlzndlmcvpmsxzkawsbz.supabase.co:5432/postgres
SUPABASE_URL=https://hlzndlmcvpmsxzkawsbz.supabase.co
# Project Settings → API → JWT Settings → JWT Secret (not the anon/publishable key)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
DATABASE_URL=sqlite+aiosqlite:///./kannans.db
PORT=8000

# Google Gemini – WhatsApp AI conversations
# From https://aistudio.google.com/apikey (usually starts with AIza)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-latest

# Meta WhatsApp Cloud API – https://developers.facebook.com
# WHATSAPP_BUSINESS_ACCOUNT_ID=  (optional reference — not used by app code)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=kannans-verify-token
META_APP_SECRET=

# Owner WhatsApp alerts (country code + number, no spaces)
OWNER_PHONE_NUMBER=917899410254

# React dashboard CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000

# Owner dashboard login (JWT — 2–3+ members can use at the same time)
DASHBOARD_USERNAME=Admin
DASHBOARD_PASSWORD=Admin@123
JWT_SECRET=generate-a-long-random-string-here
JWT_EXPIRE_HOURS=168
