{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://srivatsanka.onrender.com/api/:path*"
    },
    {
      "source": "/dev/:path*",
      "destination": "https://srivatsanka.onrender.com/dev/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
